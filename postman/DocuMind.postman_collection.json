{
  "info": {
    "name": "DocuMind",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "testuser" },
    { "key": "password", "value": "password123" },
    { "key": "token", "value": "" },
    { "key": "collectionId", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "docCollectionId", "value": "" },
    { "key": "processDocId", "value": "" },
    { "key": "blankDocId", "value": "" },
    { "key": "otherToken", "value": "" }
  ],
  "event": [{
    "listen": "prerequest",
    "script": { "exec": [
      "// Helper shared by the Processing folder: polls /status until the document is INDEXED or FAILED (max ~20 s).",
      "// Usage in a request's pre-request script: waitForProcessing(pm.collectionVariables.get('processDocId'));",
      "waitForProcessing = function (docId) {",
      "  const url = pm.collectionVariables.get('baseUrl') + '/api/documents/' + docId + '/status';",
      "  const token = pm.collectionVariables.get('token');",
      "  let tries = 0;",
      "  const poll = () => pm.sendRequest({ url: url, method: 'GET', header: { Authorization: 'Bearer ' + token } }, (err, res) => {",
      "    tries++;",
      "    const status = (!err && res.code === 200) ? res.json().documentStatus : null;",
      "    if (status === 'INDEXED' || status === 'FAILED' || tries >= 20) return;",
      "    setTimeout(poll, 1000);",
      "  });",
      "  poll();",
      "};"
    ]}
  }],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  pm.collectionVariables.set('token', pm.response.json().token);",
              "}"
            ]}
          }]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]}
          }]
