    {
      "name": "Processing",
      "description": "Needs the app running with the scheduler on. Requests 4 and 5 poll /status for up to ~20 s before running. Working directory must be the DocuMind folder (for the fixtures).",
      "item": [
        {
          "name": "1. Upload a normal text file",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/documents",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "postman/fixtures/sample.txt" },
                { "key": "title", "type": "text", "value": "Processing test" }
              ]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('processDocId', pm.response.json().id);"
            ]}
          }]
        },
        {
          "name": "2. Upload a file with no text (spaces only)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/documents",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "postman/fixtures/blank.txt" },
                { "key": "title", "type": "text", "value": "Blank test" }
              ]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('201 Created (accepted, it only fails later during processing)', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('blankDocId', pm.response.json().id);"
            ]}
          }]
        },
        {
          "name": "3. Status right after upload",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/documents/{{processDocId}}/status" },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('same document', () => pm.expect(body.documentId).to.eql(Number(pm.collectionVariables.get('processDocId'))));",
              "pm.test('has all fields', () => pm.expect(body).to.have.all.keys('documentId', 'documentStatus', 'jobStatus', 'errorMessage', 'chunkCount', 'updatedAt'));",
              "// the scheduler may or may not have run yet, so any non-failed state is fine",
              "pm.test('documentStatus is a valid in-progress or done state', () => pm.expect(body.documentStatus).to.be.oneOf(['PENDING', 'PROCESSING', 'INDEXED']));",
              "pm.test('jobStatus is a valid in-progress or done state', () => pm.expect(body.jobStatus).to.be.oneOf(['QUEUED', 'CHUNKING', 'COMPLETED']));"
            ]}
          }]
        },
        {
          "name": "4. Normal file ends up INDEXED with chunks",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/documents/{{processDocId}}/status" },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["waitForProcessing(pm.collectionVariables.get('processDocId'));"] }
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('documentStatus is INDEXED', () => pm.expect(body.documentStatus).to.eql('INDEXED'));",
                "pm.test('jobStatus is COMPLETED', () => pm.expect(body.jobStatus).to.eql('COMPLETED'));",
                "pm.test('no error message', () => pm.expect(body.errorMessage).to.not.be.ok);",
                "pm.test('at least one chunk', () => pm.expect(body.chunkCount).to.be.at.least(1));",
                "pm.test('updatedAt is set', () => pm.expect(body.updatedAt).to.be.a('string'));"
              ]}
            }
          ]
        },
        {
          "name": "5. Blank file ends up FAILED with a reason",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/documents/{{blankDocId}}/status" },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["waitForProcessing(pm.collectionVariables.get('blankDocId'));"] }
            },
            {
              "listen": "test",
              "script": { "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('documentStatus is FAILED', () => pm.expect(body.documentStatus).to.eql('FAILED'));",
                "pm.test('jobStatus is FAILED', () => pm.expect(body.jobStatus).to.eql('FAILED'));",
                "pm.test('error message explains why', () => pm.expect(body.errorMessage).to.eql('No text could be extracted'));",
                "pm.test('no chunks', () => pm.expect(body.chunkCount).to.eql(0));"
              ]}
            }
          ]
        },
        {
          "name": "6. List INDEXED documents contains the normal file",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/documents?status=INDEXED" },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const ids = pm.response.json().map(d => d.id);",
              "pm.test('contains the normal file', () => pm.expect(ids).to.include(Number(pm.collectionVariables.get('processDocId'))));",
              "pm.test('does not contain the blank file', () => pm.expect(ids).to.not.include(Number(pm.collectionVariables.get('blankDocId'))));"
            ]}
          }]
        },
