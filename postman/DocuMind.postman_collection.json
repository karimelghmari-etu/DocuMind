          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] }
          }]
        },
        {
          "name": "10. Another user cannot see my status (expect 404)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{otherToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/documents/{{processDocId}}/status"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": [
                "// register a throw-away second user and keep their token",
                "const name = 'other' + Date.now();",
                "pm.sendRequest({",
                "  url: pm.collectionVariables.get('baseUrl') + '/api/auth/register',",
                "  method: 'POST',",
                "  header: { 'Content-Type': 'application/json' },",
                "  body: { mode: 'raw', raw: JSON.stringify({ username: name, email: name + '@example.com', password: 'password123' }) }",
                "}, (err, res) => pm.collectionVariables.set('otherToken', res.json().token));"
              ]}
            },
            {
              "listen": "test",
              "script": { "exec": ["pm.test('404 Not Found (not 200, not 403: we do not reveal it exists)', () => pm.response.to.have.status(404));"] }
            }
          ]
        },
        {
          "name": "11. Clean up normal file",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/documents/{{processDocId}}" },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] }
          }]
        },
        {
          "name": "12. Clean up blank file",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/documents/{{blankDocId}}" },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] }
          }]
        }
      ]
    }
  ]
}
